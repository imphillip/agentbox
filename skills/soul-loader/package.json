{
  "name": "soul-loader",
  "version": "0.3.0",
  "description": "Archived agentbox bootstrap instructions for SoulTavern.",
  "homepage": "https://github.com/imphillip/SoulTavern",
  "license": "Apache-2.0",
  "keywords": [
    "soul",
    "soul.md",
    "sillytavern",
    "v2",
    "character-card",
    "soultavern",
    "claude-skills",
    "hermes",
    "openclaw",
    "claude-code",
    "loader"
  ],
  "agentbox": {
    "emoji": "🪪",
    "category": "loader",
    "files": {
      "SKILL.md": "./SKILL.md"
    },
    "requires": {
      "runtimes": ["hermes", "openclaw", "claude-code"],
      "engines": ["imphillip/SoulTavern"]
    },
    "triggers": [
      "load soul",
      "install character",
      "soul.md",
      "sillytavern import",
      "chub.ai card"
    ]
  }
}
